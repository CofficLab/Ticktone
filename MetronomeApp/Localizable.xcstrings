    "macOS 上可按空格键开始或停止。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On macOS, press Space to start or stop."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 上可按空格键开始或停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 上可按空白鍵開始或停止。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 上可按空白鍵開始或停止。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 上可按空白鍵開始或停止。"
          }
        }
      }
    },
    "「变速训练」从当前速度起，每若干小节按设定幅度升速或降速，直到目标速度；可设置到达目标后自动停止。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo Training starts at the current tempo and steps up or down by the set amount every few measures until it reaches the target; optionally stop automatically at the target."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「变速训练」从当前速度起，每若干小节按设定幅度升速或降速，直到目标速度；可设置到达目标后自动停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「變速訓練」從目前速度起，每若干小節按設定幅度升速或降速，直到目標速度；可設定到達目標後自動停止。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「變速訓練」從目前速度起，每若干小節按設定幅度升速或降速，直到目標速度；可設定到達目標後自動停止。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「變速訓練」從目前速度起，每若干小節按設定幅度升速或降速，直到目標速度；可設定到達目標後自動停止。"
          }
        }
      }
    },
    "「开始前预备拍」会在正式小节前先数 1–2 小节，方便留出入拍时间。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count-In counts 1–2 measures before the first full measure so you can come in on time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「开始前预备拍」会在正式小节前先数 1–2 小节，方便留出入拍时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「開始前預備拍」會在正式小節前先數 1–2 小節，方便留出入拍時間。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「開始前預備拍」會在正式小節前先數 1–2 小節，方便留出入拍時間。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「開始前預備拍」會在正式小節前先數 1–2 小節，方便留出入拍時間。"
          }
        }
      }
    },
    "「演出锁定」在播放中锁定速度与拍号，避免误触改变正在使用的节拍。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance Lock freezes tempo and time signature while playing so a stray tap can't change the beat you're using."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「演出锁定」在播放中锁定速度与拍号，避免误触改变正在使用的节拍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「演出鎖定」在播放中鎖定速度與拍號，避免誤觸改變正在使用的節拍。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「演出鎖定」在播放中鎖定速度與拍號，避免誤觸改變正在使用的節拍。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「演出鎖定」在播放中鎖定速度與拍號，避免誤觸改變正在使用的節拍。"
          }
        }
      }
    },
    "「静音（只保留视觉）」会关掉点击声，仍保留摆锤与拍点。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mute (Visual Only) silences the click while keeping the pendulum and beat dots."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「静音（只保留视觉）」会关掉点击声，仍保留摆锤与拍点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「靜音（只保留視覺）」會關掉點擊聲，仍保留鐘擺與拍點。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「靜音（只保留視覺）」會關掉點擊聲，仍保留鐘擺與拍點。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「靜音（只保留視覺）」會關掉點擊聲，仍保留鐘擺與拍點。"
          }
        }
      }
    },
